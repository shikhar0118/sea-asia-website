Options -Indexes

# Deny access to secrets, deployment notes, and files not meant for visitors.
<FilesMatch "^(?:\..*|sea-asia-config\.php|README\.md|EDITING_GUIDE\.md|WEBSITE_ISSUES\.md|vercel\.json|.*\.(?:env|sql|log|bak|ini|dist))$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:\.git|\.vercel|node_modules)(?:/|$) - [F,L,NC]

Redirect 301 /pages/service-import.html /pages/import-export-customs-clearance.html
Redirect 301 /pages/service-export.html /pages/import-export-customs-clearance.html
Redirect 301 /pages/Explore%20Sea%20Asia.html /pages/explore-sea-asia.html
