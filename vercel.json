{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.php": { "runtime": "vercel-php@0.9.0" } },
  "rewrites": [
    { "source": "/contact.php", "destination": "/api/contact.php" },
    { "source": "/php/contact-submit.php", "destination": "/api/contact-submit.php" }
  ]
}
